###########################################################

# Gemini

GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash

###########################################################

# Groq

GROQ_API_KEY=

GROQ_MODEL=llama-3.3-70b-versatile

###########################################################

# Authentication

JWT_SECRET=

###########################################################

# Account activation

# Public frontend origin; do not include /activate.
ACTIVATION_BASE_URL=http://localhost:5173

###########################################################

# SMTP mail

# For Gmail, MAIL_PASSWORD must be a Google App Password, not your normal password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Collabix
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_ENABLE=false
